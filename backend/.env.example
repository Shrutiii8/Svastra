# Database connection URL (PostgreSQL + psycopg async)
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/svastra

# Security
SECRET_KEY=change-me-in-production-use-a-strong-secret-key

# App Settings
ENVIRONMENT=development
DEMO_MODE=true

# Weather (Default location: New Delhi)
WEATHER_DEFAULT_LATITUDE=28.6139
WEATHER_DEFAULT_LONGITUDE=77.2090
WEATHER_CACHE_SECONDS=300

# CORS (JSON array or comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["*"]

# Email / Notifications (Optional)
MAIL_FROM="Svastra <noreply@svastra.local>"
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
