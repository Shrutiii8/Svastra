# Mobile App Environment Variables
# Set EXPO_PUBLIC_API_BASE_URL to reach the backend from your device.

# For Android Emulator (host machine is 10.0.2.2):
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# For Physical Android Device (replace with your machine's LAN IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:8000

# For production backend:
# EXPO_PUBLIC_API_BASE_URL=https://your-app.onrender.com
